/fotos/*.mp4
  Content-Type: video/mp4
  Accept-Ranges: bytes
  Cache-Control: public, max-age=31536000, immutable

/fotos/*.mov
  Content-Type: video/quicktime
  Accept-Ranges: bytes
  Cache-Control: public, max-age=31536000, immutable

/fotos/*.jpg
  Content-Type: image/jpeg
  Cache-Control: public, max-age=31536000, immutable

/fotos/*.png
  Content-Type: image/png
  Cache-Control: public, max-age=31536000, immutable
